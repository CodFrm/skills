#!/usr/bin/env bash
# SessionStart hook: inject the using-dev-kit bootstrap into the session context.
# Modelled on obra/superpowers' session-start (MIT); emits the field each platform expects.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CODEX_PLUGIN_ROOT="${PLUGIN_ROOT:-}"
DEVKIT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# JSON-escape using bash parameter substitution, one pass per character class — far faster
# than looping character by character.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# emit_additional_context <hookEventName> <text>
#
# Claude Code reads the nested hookSpecificOutput; Copilot CLI and friends read a top-level
# additionalContext (the SDK's standard shape). Emit only the one this platform wants.
# printf rather than a heredoc, to dodge the bash 5.3+ heredoc hang.
emit_additional_context() {
    local event="$1" text
    text="$(escape_for_json "$2")"
    if [ -z "$CODEX_PLUGIN_ROOT" ] && [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
        printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$event" "$text"
    else
        printf '{\n  "additionalContext": "%s"\n}\n' "$text"
    fi
}

# If it cannot be read, exit silently and inject nothing: an "Error reading …" line would be
# wrapped in <EXTREMELY_IMPORTANT> and read by the agent as its bootstrap.
bootstrap_content="$(cat "${DEVKIT_ROOT}/skills/using-dev-kit/SKILL.md" 2>/dev/null)" || exit 0
[ -n "$bootstrap_content" ] || exit 0

session_context="$(printf '<EXTREMELY_IMPORTANT>\ndev-kit:using-dev-kit bootstrap loaded. Follow it now.\n\n%s\n</EXTREMELY_IMPORTANT>' "$bootstrap_content")"

emit_additional_context SessionStart "$session_context"

exit 0

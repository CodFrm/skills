#!/usr/bin/env bash
# SessionStart hook: inject the using-dev-kit bootstrap into the session context.
# Modelled on obra/superpowers' session-start (MIT); emits the field each platform expects.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# JSON-escape using bash parameter substitution, one pass per character class — far faster
# than looping character by character.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# emit_additional_context <hookEventName> <text>
#
# The two harnesses read different fields: Claude Code reads the nested hookSpecificOutput,
# while Copilot CLI and friends read a top-level additionalContext (the SDK's standard shape).
# Emit only the one the current platform wants.
# printf rather than a heredoc, to dodge the bash 5.3+ heredoc hang.
emit_additional_context() {
    local event="$1" text
    text="$(escape_for_json "$2")"
    if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
        printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$event" "$text"
    else
        printf '{\n  "additionalContext": "%s"\n}\n' "$text"
    fi
}

# If it cannot be read, exit silently and inject nothing. Stuffing an "Error reading …" line
# into the context is worse: it would be wrapped in <EXTREMELY_IMPORTANT> and sent into the
# session, leaving the agent to read that error message as its bootstrap.
bootstrap_content="$(cat "${PLUGIN_ROOT}/skills/using-dev-kit/SKILL.md" 2>/dev/null)" || exit 0
[ -n "$bootstrap_content" ] || exit 0

session_context="$(printf '<EXTREMELY_IMPORTANT>\nYou have loaded dev-kit.\n\n**Below is the full content of the dev-kit:using-dev-kit bootstrap — it is your entry point for using these skills. Invoke the other skills with the '"'"'Skill'"'"' tool:**\n\n%s\n</EXTREMELY_IMPORTANT>' "$bootstrap_content")"

emit_additional_context SessionStart "$session_context"

exit 0

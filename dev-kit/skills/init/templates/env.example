# <project> local runtime verification only.
# Copy to ignored .env. Only the e2e harness loads it; smoke/application never do.
# Real targets have real side effects: run only authorized operations and clean up.
# One KEY=value per line; delete unused service blocks.

# <service A>
E2E_<A>_HOST=<address>
E2E_<A>_PORT=<port>
E2E_<A>_USER=<username>
E2E_<A>_PASSWORD=changeme

# <service B; document path/auth traps above the field>
E2E_<B>_HOST=<address>
E2E_<B>_PORT=<port>
E2E_<B>_AUTH=key
E2E_<B>_KEY=<absolute path>
# E2E_<B>_PASSWORD=
